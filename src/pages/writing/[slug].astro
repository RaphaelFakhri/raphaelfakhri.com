---
import Base from '../../layouts/Base.astro';
import { articles } from '../../data/writing.js';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---
<Base
  title={`${article.title} — Raphael Fakhri`}
  description={article.summary}
  path={`/writing/${article.slug}/`}
  ogType="article"
>
  <article class="essay">
    <a class="back-link" href="/#writing">&larr; Back to writing</a>

    <header class="essay-header">
      <div class="essay-meta">
        <time datetime={article.isoDate}>{article.date}</time>
        <span>&middot;</span>
        <span>{article.readTime}</span>
      </div>
      <h1>{article.title}</h1>
      <p class="essay-summary">{article.summary}</p>
    </header>

    <div class="essay-body">
      {article.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <footer class="essay-footer">
      <p>
        Have thoughts or want to compare notes? Reach me at{' '}
        <a href="mailto:mail@raphaelfakhri.com">mail@raphaelfakhri.com</a>.
      </p>
      <a href="/#work">See selected work &rarr;</a>
    </footer>
  </article>

  <style>
    .essay {
      max-width: 65ch;
    }

    .back-link {
      display: inline-block;
      font-size: 0.88rem;
      font-weight: 550;
      margin-bottom: 1.5rem;
      color: var(--text-muted);
    }

    .back-link:hover {
      color: var(--accent);
    }

    .essay-header {
      padding-bottom: 1.5rem;
      margin-bottom: 1.75rem;
      border-bottom: 1px solid var(--border);
    }

    .essay-meta {
      display: flex;
      gap: 0.45rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }

    .essay-summary {
      margin: 0.85rem 0 0;
      font-size: 1.05rem;
      color: var(--text-secondary);
    }

    .essay-body p {
      font-size: 1.02rem;
      line-height: 1.78;
      margin-bottom: 1.15rem;
      color: var(--text);
    }

    .essay-footer {
      margin-top: 2.5rem;
      padding-top: 1.4rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      font-size: 0.92rem;
    }

    .essay-footer p {
      margin: 0;
      color: var(--text-muted);
    }
  </style>
</Base>
