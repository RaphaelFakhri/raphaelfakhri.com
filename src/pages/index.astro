---
import Base from '../layouts/Base.astro';

const mergedPrsUrl =
  'https://github.com/search?q=is%3Apr+author%3ARaphaelFakhri+is%3Amerged+-user%3ARaphaelFakhri&type=pullrequests';
---
<Base
  title="Raphael Fakhri — Senior Mobile & Systems Engineer"
  description="Software engineer in Beirut owning production mobile apps, university web platforms, 739 merged open-source PRs, and GPU parallel systems."
  path="/"
>
  <!-- Top Live Telemetry Hairline Bar -->
  <header class="telemetry-bar" aria-label="Live telemetry and controls">
    <div class="telemetry-group">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span id="telemetry-clock">BEIRUT --:--:--</span>
      <span class="sep hide-sm">/</span>
      <span class="muted hide-md">33.89°N 35.50°E</span>
    </div>

    <div class="telemetry-group telemetry-mid hide-sm">
      <span id="telemetry-fps">FPS --</span>
      <span class="sep">/</span>
      <span id="telemetry-lcp">LCP --</span>
      <span class="sep">/</span>
      <a href={mergedPrsUrl} target="_blank" rel="noopener noreferrer" class="telemetry-link">
        739 MERGED PRS ↗
      </a>
    </div>

    <div class="telemetry-group telemetry-actions">
      <button type="button" id="telemetry-xray" class="pill-btn" title="Toggle 3D X-Ray & Exploded View (W)">
        X-RAY [W]
      </button>
      <button type="button" id="telemetry-cmdk" class="pill-btn pill-accent" title="Open Command Palette (⌘K)">
        ⌘K
      </button>
    </div>
  </header>

  <!-- Full-Viewport Interactive 3D Studio Stage -->
  <section class="studio-stage" id="work" aria-label="Interactive 3D Portfolio Stage">
    <div class="stage-viewport" id="stage-viewport">
      <div class="stage-grid" aria-hidden="true">
        <span class="crosshair ch-tl">+</span>
        <span class="crosshair ch-tr">+</span>
        <span class="crosshair ch-bl">+</span>
        <span class="crosshair ch-br">+</span>
      </div>

      <canvas id="stage-canvas" aria-label="Interactive 3D showcase — drag to orbit"></canvas>

      <!-- True 3D CSS+Canvas Fallback Stage (automatically active only when WebGL is disabled) -->
      <div id="stage-fallback" class="stage-fallback" hidden aria-hidden="true">
        <!-- 01 · AUB Mediterraneo Display Slab -->
        <div class="fb-rig fb-aubmed is-active" data-fallback-rig="0">
          <div class="fb-layer fb-backplate"></div>
          <div class="fb-layer fb-display">
            <div class="fb-chrome">
              <span></span><span></span><span></span>
              <small>aubmed.ac.cy · sole owner 2023–2025</small>
            </div>
            <img src="/work-aubmed.jpg" alt="" width="1440" height="900" loading="eager" decoding="async" />
          </div>
          <div class="fb-layer fb-spec-chip">50+ PAGES · 200+ REQUESTS · 100% ON TIME</div>
        </div>

        <!-- 02 · Zaky Dual Titanium iPhones -->
        <div class="fb-rig fb-zaky" data-fallback-rig="1">
          <div class="fb-phone fb-phone-back">
            <span class="fb-island"></span>
            <img src="/work-zaky-2.jpg" alt="" width="560" height="1217" loading="lazy" decoding="async" />
          </div>
          <div class="fb-phone fb-phone-front">
            <span class="fb-island"></span>
            <img src="/work-zaky-1.jpg" alt="" width="560" height="1217" loading="eager" decoding="async" />
          </div>
        </div>

        <!-- 03 · 739 Merged Open-Source PR Glass Stack -->
        <div class="fb-rig fb-oss" data-fallback-rig="2">
          <div class="fb-pr fb-pr-1">
            <div class="fb-pr-top"><span class="fb-merged">● MERGED</span><span>#2384 · C# / .NET</span></div>
            <strong>fluentmigrator/fluentmigrator</strong>
            <small>NULL semantics across 8 SQL database engines</small>
          </div>
          <div class="fb-pr fb-pr-2">
            <div class="fb-pr-top"><span class="fb-merged">● MERGED</span><span>#5135 · GO / WEBRTC</span></div>
            <strong>livekit/livekit</strong>
            <small>WebRTC RTX payload-type negotiation fix</small>
          </div>
          <div class="fb-pr fb-pr-3">
            <div class="fb-pr-top"><span class="fb-merged">● MERGED</span><span>#519 · SWIFT / RN</span></div>
            <strong>callstack/react-native-brownfield</strong>
            <small>iOS NSNumber boxing fix for native bridge</small>
          </div>
        </div>

        <!-- 04 · CUDA Heap HUD Label (3D lattice renders live on Canvas2D behind it) -->
        <div class="fb-rig fb-cuda" data-fallback-rig="3">
          <div class="fb-cuda-badge">CUDA PARALLEL HEAPS · -88% SORT TIME (10M+ ELEMENTS)</div>
        </div>
      </div>
    </div>

    <div class="hud-layer">
      <!-- Top-Left: Architectural Identity & Physics ID Badge -->
      <aside class="hud-card identity-card">
        <div class="identity-top">
          <div class="id-badge" data-badge title="Raphael Fakhri · Beirut">
            <img
              src="/raphael.jpg"
              alt="Raphael Fakhri"
              width="64"
              height="64"
              loading="eager"
              decoding="async"
            />
            <span class="id-code">RF·01</span>
          </div>

          <div class="identity-headings">
            <div class="micro-eyebrow">BEIRUT · SENIOR ENGINEER</div>
            <h1>Raphael <em>Fakhri</em></h1>
          </div>
        </div>

        <p class="identity-bio">
          Sole engineer behind production iOS/Android &amp; web platforms,
          <strong>739 merged open-source PRs</strong>, and GPU parallel algorithms.
        </p>

        <nav class="identity-links" aria-label="Direct links">
          <a href="/cv/" class="link-primary">CV ↗</a>
          <a href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <button type="button" data-copy-email>Email</button>
          <a href="#dossier">Dossier ↓</a>
        </nav>
      </aside>

      <!-- Bottom-Left: Razor-Thin Selected Work Index -->
      <div class="hud-card index-card">
        <div class="index-head">
          <span>SELECTED WORK</span>
          <span class="muted">KEYS 1–4</span>
        </div>

        <div class="work-list" role="tablist" aria-label="Selected projects">
          <button type="button" class="work-row is-active" role="tab" aria-selected="true" data-work-index="0">
            <span class="w-num">01</span>
            <span class="w-name">AUB Mediterraneo</span>
            <span class="w-cat">Web · Sole Owner</span>
            <span class="w-yr">2023–25</span>
          </button>

          <button type="button" class="work-row" role="tab" aria-selected="false" data-work-index="1">
            <span class="w-num">02</span>
            <span class="w-name">Zaky</span>
            <span class="w-cat">RN / Expo · Client</span>
            <span class="w-yr">2026</span>
          </button>

          <button type="button" class="work-row" role="tab" aria-selected="false" data-work-index="2">
            <span class="w-num">03</span>
            <span class="w-name">739 Merged PRs</span>
            <span class="w-cat">Open Source</span>
            <span class="w-yr">GitHub</span>
          </button>

          <button type="button" class="work-row" role="tab" aria-selected="false" data-work-index="3">
            <span class="w-num">04</span>
            <span class="w-name">CUDA &amp; Systems</span>
            <span class="w-cat">MSc 3.81 · WaveMark</span>
            <span class="w-yr">2023–26</span>
          </button>
        </div>
      </div>

      <!-- Bottom-Right: Dynamic Artifact Caption & Controls -->
      <div class="caption-wrap">
        <div class="hud-card caption-card">
          <div class="caption-top">
            <span id="caption-num" class="micro-eyebrow">01 / 04</span>
            <div class="caption-controls">
              <button type="button" id="hold-xray-btn" class="mini-pill" title="Press and hold for exploded wireframe X-Ray">
                HOLD X-RAY
              </button>
              <button type="button" id="btn-prev" class="arrow-btn" aria-label="Previous project">←</button>
              <button type="button" id="btn-next" class="arrow-btn" aria-label="Next project">→</button>
            </div>
          </div>

          <h2 id="caption-title">AUB Mediterraneo</h2>
          <div id="caption-role" class="caption-role">Sole Developer &amp; Designer · 2023–2025</div>
          <p id="caption-summary" class="caption-summary">
            Sole owner of the Cyprus campus web platform for two years — 50+ responsive pages, in-page PDF viewer, tree navigation, and 200+ staff requests shipped 100% on time.
          </p>

          <div class="caption-foot">
            <div id="caption-tags" class="tag-row">
              <span>C# / .NET</span>
              <span>SharePoint</span>
              <span>JavaScript</span>
            </div>
            <a
              id="caption-cta"
              class="cta-link"
              href="https://aubmed.ac.cy"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit aubmed.ac.cy ↗
            </a>
          </div>
        </div>

        <div class="stage-hint">DRAG STAGE TO ORBIT · KEYS 1–4 SWITCH · W X-RAY · ⌘K COMMANDS</div>
      </div>
    </div>
  </section>

  <!-- Below the Fold: Ultra-Tight Architectural Dossier -->
  <main id="dossier" class="dossier-section">
    <div class="dossier-container">
      <div class="dossier-head">
        <div>
          <div class="micro-eyebrow">02 · PRODUCTION RECORD</div>
          <h2>Shipped &amp; owned end to end</h2>
        </div>
        <div class="dossier-head-actions">
          <a class="btn-solid" href="/cv/">Interactive CV ↗</a>
          <a class="btn-ghost" href="/cv/Raphael_Fakhri_CV.pdf" target="_blank" rel="noopener noreferrer">PDF CV ↓</a>
        </div>
      </div>

      <div class="ledger">
        <div class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-year">2026</span>
            <span class="ledger-tag">Client · Sole Engineer</span>
          </div>
          <div class="ledger-body">
            <h3>Zaky — Cross-Platform Mobile Tutoring App</h3>
            <p>
              130+ screen React Native (Expo) app live on iOS, Android, and Web (760+ requests) — serialized MMKV offline sync, native Kotlin Android Credential Manager, LiveKit video classrooms, and Python/SymPy/Manim video pipeline.
            </p>
          </div>
        </div>

        <div class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-year">2026</span>
            <span class="ledger-tag">Production Ops</span>
          </div>
          <div class="ledger-body">
            <h3>24/7 AI Customer Support Platform</h3>
            <p>
              End-to-end client support agent on self-hosted Chatwoot and Claude unifying web chat, Shopify, WhatsApp, email, and mobile routing continuously in production.
            </p>
          </div>
        </div>

        <div class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-year">2025</span>
            <span class="ledger-tag">Enterprise Systems</span>
          </div>
          <div class="ledger-body">
            <h3>Cardinal Health | WaveMark</h3>
            <p>
              Automated Python &amp; DSPy reconciliation agent detecting staging-to-production schema and data drift across ClickHouse, Kafka, and Elasticsearch with patch proposals for engineer review.
            </p>
          </div>
        </div>

        <div class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-year">2023–2025</span>
            <span class="ledger-tag">Sole Owner · 2 Yrs</span>
          </div>
          <div class="ledger-body">
            <h3>
              <a href="https://aubmed.ac.cy" target="_blank" rel="noopener noreferrer">AUB Mediterraneo (aubmed.ac.cy) ↗</a>
            </h3>
            <p>
              Sole developer and designer for two years during my MSc — 50+ responsive pages, in-page PDF viewer, tree navigation, and 200+ staff requests shipped 100% on time.
            </p>
          </div>
        </div>

        <div class="ledger-row">
          <div class="ledger-meta">
            <span class="ledger-year">2023</span>
            <span class="ledger-tag">Backend &amp; Data</span>
          </div>
          <div class="ledger-body">
            <h3>Saint Joseph University (USJ)</h3>
            <p>
              .NET Core &amp; RabbitMQ Student Information System APIs with vendor CME, MySQL → PostgreSQL production migration, and a 15+ page Laravel HR module with granular SQL permissions.
            </p>
          </div>
        </div>
      </div>

      <div class="split-proof">
        <article class="proof-box">
          <div class="micro-eyebrow">OPEN SOURCE · VERIFIED</div>
          <h3>739 Merged Upstream Pull Requests</h3>
          <p>
            Reviewed and merged across React Native (Callstack, Software Mansion, RevenueCat), .NET
            (<a href="https://github.com/fluentmigrator/fluentmigrator/pull/2384" target="_blank" rel="noopener noreferrer">FluentMigrator #2384</a>,
            <a href="https://github.com/domaindrivendev/Swashbuckle.AspNetCore/pull/4128" target="_blank" rel="noopener noreferrer">Swashbuckle #4128</a>),
            WebRTC
            (<a href="https://github.com/livekit/livekit/pull/5135" target="_blank" rel="noopener noreferrer">LiveKit #5135</a>,
            <a href="https://github.com/versatica/mediasoup/pull/1953" target="_blank" rel="noopener noreferrer">mediasoup #1953</a>),
            <a href="https://github.com/callstack/react-native-brownfield/pull/519" target="_blank" rel="noopener noreferrer">react-native-brownfield #519</a>,
            and Temporal SDKs.
          </p>
          <a class="cta-link" href={mergedPrsUrl} target="_blank" rel="noopener noreferrer">
            Browse all 739 merged PRs on GitHub ↗
          </a>
        </article>

        <article class="proof-box">
          <div class="micro-eyebrow">RESEARCH &amp; GPU SYSTEMS</div>
          <h3>AUB MSc Computer Science · GPA 3.81</h3>
          <p>
            Thesis: VS Code extension explaining code in place via eye-tracker gaze, voice, or mouse, evaluated in a controlled user study. Also built
            <a href="https://github.com/RaphaelFakhri/Generalized_Heaps_Parallel" target="_blank" rel="noopener noreferrer">CUDA parallel heaps</a>
            cutting 10M+ element sort time by <strong>88%</strong>.
          </p>
          <a
            class="cta-link"
            href="https://github.com/RaphaelFakhri/Generalized_Heaps_Parallel"
            target="_blank"
            rel="noopener noreferrer"
          >
            Inspect CUDA Parallel Heaps ↗
          </a>
        </article>
      </div>
    </div>
  </main>

  <footer id="contact" class="site-footer">
    <div class="dossier-container footer-inner">
      <div>
        <strong>Raphael Fakhri</strong>
        <span class="sep">·</span>
        <span class="muted">Beirut, Lebanon</span>
      </div>
      <div class="footer-links">
        <a href="mailto:mail@raphaelfakhri.com">mail@raphaelfakhri.com</a>
        <a href="/cv/">CV</a>
        <a href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/raphaelfakhri2" target="_blank" rel="noopener noreferrer">X</a>
      </div>
    </div>
  </footer>

  <!-- Command Palette (⌘K) -->
  <div id="cmd-palette" class="cmd-backdrop" hidden role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="cmd-modal">
      <div class="cmd-search-row">
        <span class="cmd-prompt">&gt;</span>
        <input
          id="cmd-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="Jump to project, toggle 3D X-Ray, open CV, copy email..."
        />
        <kbd>ESC</kbd>
      </div>
      <div id="cmd-list" class="cmd-list"></div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    import '../scripts/stage.js';
  </script>
</Base>

<style>
  /* ---------------- Top Telemetry Bar ---------------- */
  .telemetry-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: 40px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(7, 7, 8, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .telemetry-group {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.8);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  .sep { color: rgba(243, 239, 231, 0.22); }
  .muted { color: var(--text-muted); }

  .telemetry-link {
    color: var(--accent);
    font-weight: 500;
  }

  .pill-btn {
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .pill-btn:hover,
  .pill-btn.is-active {
    border-color: var(--accent);
    color: var(--text);
    background: var(--accent-soft);
  }

  .pill-accent {
    border-color: rgba(216, 168, 120, 0.4);
    color: var(--accent-bright);
  }

  /* ---------------- Full-Viewport 3D Studio Stage ---------------- */
  .studio-stage {
    position: relative;
    min-height: 100svh;
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .stage-viewport {
    position: absolute;
    inset: 40px 0 0 0;
    z-index: 1;
    cursor: grab;
  }

  .stage-viewport.is-dragging {
    cursor: grabbing;
  }

  .stage-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(243, 239, 231, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(243, 239, 231, 0.03) 1px, transparent 1px);
    background-size: 25% 33.333%;
  }

  .crosshair {
    position: absolute;
    font-family: var(--mono);
    font-size: 13px;
    color: rgba(243, 239, 231, 0.16);
    user-select: none;
  }

  .ch-tl { top: 14px; left: 18px; }
  .ch-tr { top: 14px; right: 18px; }
  .ch-bl { bottom: 14px; left: 18px; }
  .ch-br { bottom: 14px; right: 18px; }

  #stage-canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }

  /* ---------------- Software 3D Spatial Fallback (Non-WebGL Browsers) ---------------- */
  .stage-fallback {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    perspective: 1400px;
  }

  .stage-fallback[hidden] {
    display: none;
  }

  .fb-rig {
    position: absolute;
    left: 66%;
    top: 41%;
    margin-left: -260px;
    margin-top: -165px;
    width: 520px;
    height: 330px;
    transform-style: preserve-3d;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    display: grid;
    place-items: center;
  }

  .fb-rig.is-active {
    opacity: 1;
  }

  /* 01 AUBMED Display */
  .fb-backplate {
    position: absolute;
    width: 470px;
    height: 298px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(216, 168, 120, 0.22), rgba(20, 20, 24, 0.8));
    border: 1px solid rgba(216, 168, 120, 0.45);
    transform: translateZ(-28px);
    transition: transform 0.4s ease;
  }

  .fb-display {
    position: relative;
    width: 460px;
    border-radius: 12px;
    overflow: hidden;
    background: #141416;
    border: 1px solid rgba(243, 239, 231, 0.22);
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.72), 0 0 0 1px rgba(216, 168, 120, 0.16);
    transform: translateZ(18px);
    transition: transform 0.4s ease, border-color 0.3s ease;
  }

  .fb-chrome {
    height: 24px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: #19191c;
    border-bottom: 1px solid var(--border);
  }

  .fb-chrome span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(243, 239, 231, 0.22);
  }

  .fb-chrome small {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--text-muted);
  }

  .fb-display img {
    display: block;
    width: 100%;
    height: auto;
  }

  .fb-spec-chip {
    position: absolute;
    right: -12px;
    bottom: -14px;
    padding: 6px 11px;
    border-radius: 7px;
    background: rgba(10, 10, 12, 0.92);
    border: 1px solid rgba(216, 168, 120, 0.45);
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--accent-bright);
    transform: translateZ(56px);
    transition: transform 0.4s ease;
  }

  :global(body.is-xray) .fb-backplate {
    transform: translateZ(-76px);
    border-color: var(--cyan);
    background: rgba(124, 196, 250, 0.08);
  }

  :global(body.is-xray) .fb-display {
    transform: translateZ(56px);
    border-color: var(--cyan);
  }

  :global(body.is-xray) .fb-spec-chip {
    transform: translateZ(110px);
    border-color: var(--cyan);
    color: var(--cyan);
  }

  /* 02 Zaky Dual Titanium iPhones */
  .fb-phone {
    position: absolute;
    width: 172px;
    border-radius: 26px;
    padding: 6px;
    background: linear-gradient(145deg, #353330, #161618);
    border: 1px solid rgba(216, 168, 120, 0.42);
    box-shadow: 0 34px 80px rgba(0, 0, 0, 0.78);
    transition: transform 0.4s ease, border-color 0.3s ease;
  }

  .fb-phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .fb-island {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 44px;
    height: 11px;
    margin-left: -22px;
    border-radius: 999px;
    background: #050506;
    z-index: 2;
  }

  .fb-phone-front {
