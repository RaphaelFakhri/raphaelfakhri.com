---
import Base from '../layouts/Base.astro';
import Sculpture3D from '../components/Sculpture3D.astro';
import { articles } from '../data/writing.js';
---
<Base
  title="Raphael Fakhri — Mobile & Full-Stack Engineer"
  description="Mobile, backend, and AI systems engineered end to end. Beirut."
  path="/"
>
  <section class="hero">
    <div class="hero-copy">
      <div class="identity">
        <img
          class="avatar"
          src="/raphael.jpg"
          alt="Raphael Fakhri"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
        />
        <span class="pill">Beirut &middot; Mobile &amp; Full-Stack</span>
      </div>

      <h1>Raphael Fakhri</h1>

      <p class="lead">
        Mobile, backend, and AI systems&mdash;shipped end to end.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href="#work">Selected work</a>
        <a class="btn" href="/cv/">CV</a>
        <a class="btn" href="mailto:mail@raphaelfakhri.com">Email</a>
      </div>
    </div>

    <div class="hero-visual">
      <Sculpture3D />
    </div>
  </section>

  <section id="story" class="section">
    <div class="eyebrow">Story</div>
    <h2>From university infrastructure to sole-engineer product launches</h2>

    <ol class="chapters">
      <li>
        <span class="step">01</span>
        <h3>Foundations</h3>
        <p>
          CS at USJ. Shipped .NET Core APIs, RabbitMQ pipelines, and a live MySQL&rarr;PostgreSQL migration.
        </p>
      </li>
      <li>
        <span class="step">02</span>
        <h3>Ownership</h3>
        <p>
          MSc at AUB (3.81) while solo-owning <a href="https://aubmed.ac.cy" target="_blank" rel="noopener noreferrer">aubmed.ac.cy</a> (200+ requests), plus a drift agent at Cardinal Health.
        </p>
      </li>
      <li>
        <span class="step">03</span>
        <h3>End-to-end</h3>
        <p>
          Sole engineer on Zaky across iOS, Android &amp; Web, plus merged PRs in React Native, .NET, and LiveKit.
        </p>
      </li>
    </ol>
  </section>

  <section id="work" class="section">
    <div class="eyebrow">Selected Work</div>
    <h2>Built and shipped</h2>

    <div class="gallery">
      <article class="tile tile-wide" data-tilt>
        <div class="tile-inner">
          <div class="tile-top">
            <span class="index">01 &middot; Client Work &middot; Sole Engineer</span>
            <span class="metric">130+ screens &middot; 760+ requests</span>
          </div>
          <h3>Zaky</h3>
          <p>
            Cross-platform AI tutoring app live on iOS, Android, and Web. Serialized MMKV offline sync, Kotlin Credential Manager module, LiveKit video classrooms, and a Python/SymPy/Manim homework video pipeline.
          </p>
          <div class="tags">
            <span>React Native / Expo</span>
            <span>Kotlin</span>
            <span>LiveKit</span>
            <span>Python AI</span>
          </div>
        </div>
      </article>

      <article class="tile" data-tilt>
        <div class="tile-inner">
          <div class="tile-top">
            <span class="index">02 &middot; Upstream</span>
            <a class="ext" href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub &nearr;</a>
          </div>
          <h3>Open-Source Fixes</h3>
          <p>
            Merged PRs across Callstack, Software Mansion, <a href="https://github.com/fluentmigrator/fluentmigrator/pull/2384" target="_blank" rel="noopener noreferrer">FluentMigrator</a> (10), <a href="https://github.com/domaindrivendev/Swashbuckle.AspNetCore/pull/4128" target="_blank" rel="noopener noreferrer">Swashbuckle</a> (10), <a href="https://github.com/livekit/livekit/pull/5135" target="_blank" rel="noopener noreferrer">LiveKit</a>, and <a href="https://github.com/versatica/mediasoup/pull/1953" target="_blank" rel="noopener noreferrer">mediasoup</a>.
          </p>
          <div class="tags">
            <span>TypeScript</span>
            <span>C#</span>
            <span>Go / C++</span>
          </div>
        </div>
      </article>

      <article class="tile" data-tilt>
        <div class="tile-inner">
          <div class="tile-top">
            <span class="index">03 &middot; Agentic Systems</span>
            <a class="ext" href="https://github.com/RaphaelFakhri/shipment-triage" target="_blank" rel="noopener noreferrer">Repo &nearr;</a>
          </div>
          <h3>shipment-triage</h3>
          <p>
            Durable Temporal + LangGraph workflow with Qdrant RAG, a human approval gate, DeepEval CI checks, and a test that kills the worker mid-flight.
          </p>
          <div class="tags">
            <span>Temporal</span>
            <span>LangGraph</span>
            <span>Qdrant</span>
          </div>
        </div>
      </article>

      <article class="tile" data-tilt>
        <div class="tile-inner">
          <div class="tile-top">
            <span class="index">04 &middot; Backend</span>
            <a class="ext" href="https://github.com/RaphaelFakhri/grant-management-api" target="_blank" rel="noopener noreferrer">Repo &nearr;</a>
          </div>
          <h3>grant-management-api</h3>
          <p>
            Clean-architecture .NET 8 and SQL Server API with hand-tuned T-SQL, 70 tests, and Kubernetes Job migrations verified on a live kind cluster in CI.
          </p>
          <div class="tags">
            <span>.NET 8</span>
            <span>T-SQL</span>
            <span>Kubernetes</span>
          </div>
        </div>
      </article>

      <article class="tile" data-tilt>
        <div class="tile-inner">
          <div class="tile-top">
            <span class="index">05 &middot; Systems &amp; Research</span>
            <a class="ext" href="https://github.com/RaphaelFakhri/Generalized_Heaps_Parallel" target="_blank" rel="noopener noreferrer">Repo &nearr;</a>
          </div>
          <h3>CUDA Heaps &amp; MSc Thesis</h3>
          <p>
            Block- and warp-level CUDA heaps cutting 10M+ element sort time by 88%. MSc thesis: eye-tracking, voice, and mouse code explanations inside VS Code.
          </p>
          <div class="tags">
            <span>CUDA / C++</span>
            <span>VS Code</span>
          </div>
        </div>
      </article>
    </div>

    <p class="also">
      Also shipped: <a href="https://aubmed.ac.cy" target="_blank" rel="noopener noreferrer">aubmed.ac.cy</a> (200+ requests), Cardinal Health DSPy drift agent, and a 24/7 Chatwoot + Claude support system.
    </p>
  </section>

  <section id="writing" class="section">
    <div class="eyebrow">Writing</div>
    <h2>Notes</h2>

    <div class="notes">
      {articles.map((article) => (
        <a class="note-row" href={`/writing/${article.slug}/`}>
          <div>
            <h3>{article.title}</h3>
            <p>{article.summary}</p>
          </div>
          <span class="note-meta">{article.readTime} &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="eyebrow">Contact</div>
    <h2 class="contact-title">Let&rsquo;s build something that lasts.</h2>
    <div class="actions">
      <a class="btn btn-primary" href="mailto:mail@raphaelfakhri.com">mail@raphaelfakhri.com</a>
      <a class="btn" href="/cv/">View CV</a>
      <a class="btn" href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    if (!reduced && finePointer) {
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          const rx = (0.5 - py) * 7;
          const ry = (px - 0.5) * 7;
          card.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
          card.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
          card.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateZ(4px)`;
        });

        card.addEventListener('pointerleave', () => {
          card.style.transform = '';
        });
      });
    }
  </script>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 2rem;
      min-height: min(74svh, 620px);
      padding: 1.5rem 0 0.5rem;
    }

    .identity {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      margin-bottom: 1.65rem;
    }

    .avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border-strong);
      display: block;
    }

    .pill {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      padding: 0.32rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
    }

    .lead {
      font-size: clamp(1.12rem, 1.9vw, 1.32rem);
      line-height: 1.55;
      color: var(--text-secondary);
      max-width: 34ch;
      margin: 1.15rem 0 2rem;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.62rem 1.15rem;
      border-radius: 999px;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      color: var(--text);
      font-size: 0.88rem;
      font-weight: 550;
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .btn:hover {
      border-color: var(--accent-border);
      background: var(--surface-hover);
      color: var(--text);
      text-decoration: none;
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--text);
      border-color: var(--text);
      color: #08090c;
    }

    .btn-primary:hover {
      background: #dce8ff;
      border-color: #dce8ff;
      color: #08090c;
    }

    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Story chapters */
    .chapters {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.25rem;
    }

    .step {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.74rem;
      color: var(--accent);
      margin-bottom: 0.65rem;
    }

    .chapters p {
      font-size: 0.94rem;
      line-height: 1.65;
    }

    /* 3D sculptural gallery */
    .gallery {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .tile {
      position: relative;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background:
        radial-gradient(360px circle at var(--mx, 50%) var(--my, 0%), rgba(125, 180, 255, 0.11), transparent 60%),
        var(--surface);
      transition: transform 0.22s ease, border-color 0.22s ease;
      transform-style: preserve-3d;
      will-change: transform;
    }

    .tile:hover {
      border-color: var(--accent-border);
    }

    .tile-wide {
      grid-column: 1 / -1;
      background:
        radial-gradient(520px circle at var(--mx, 80%) var(--my, 20%), rgba(96, 165, 250, 0.15), transparent 62%),
        linear-gradient(135deg, rgba(125, 180, 255, 0.06), rgba(255, 255, 255, 0.015));
    }

    .tile-inner {
      padding: 1.65rem 1.75rem;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .tile-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.9rem;
    }

    .index, .metric {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }

    .metric {
      color: var(--accent);
    }

    .ext {
      font-size: 0.82rem;
      font-weight: 550;
      color: var(--text-secondary);
    }

    .ext:hover {
      color: var(--accent);
      text-decoration: none;
    }

    .tile h3 {
      font-size: 1.2rem;
      margin-bottom: 0.55rem;
      color: var(--text);
    }

    .tile-wide h3 {
      font-size: 1.45rem;
    }

    .tile p {
      font-size: 0.93rem;
      line-height: 1.65;
      max-width: 62ch;
    }

    .tags {
      margin-top: auto;
      padding-top: 1.25rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .tags span {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.71rem;
      color: var(--text-secondary);
      padding: 0.22rem 0.58rem;
      border-radius: 999px;
      border: 1px solid var(--border);
    }

    .also {
      margin-top: 1.65rem;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    /* Writing */
    .notes {
      display: flex;
      flex-direction: column;
      border-top: 1px solid var(--border);
    }

    .note-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border);
      transition: padding-left 0.18s ease;
    }

    .note-row:hover {
      text-decoration: none;
      padding-left: 0.45rem;
    }

    .note-row h3 {
      color: var(--text);
      margin-bottom: 0.35rem;
    }

    .note-row:hover h3 {
      color: var(--accent);
    }

    .note-row p {
      font-size: 0.92rem;
      max-width: 58ch;
    }

    .note-meta {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.78rem;
      color: var(--text-muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Contact */
    .contact {
      padding-bottom: 1rem;
    }

    .contact-title {
      font-size: clamp(1.85rem, 4vw, 2.75rem);
      letter-spacing: -0.035em;
      max-width: 18ch;
      margin-bottom: 1.75rem;
    }

    @media (max-width: 820px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
        gap: 1.5rem;
      }

      .hero-visual {
        order: -1;
        max-width: 300px;
        margin: 0 auto;
        width: 100%;
      }

      .chapters,
      .gallery {
        grid-template-columns: 1fr;
      }

      .note-row {
        flex-direction: column;
        gap: 0.55rem;
      }
    }
  </style>
</Base>
