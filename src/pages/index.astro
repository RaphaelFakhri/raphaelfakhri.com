---
import Base from '../layouts/Base.astro';
---
<Base
  title="Raphael Fakhri — Software Engineer"
  description="Software engineer in Beirut owning mobile apps, production web platforms, and backend systems end to end."
  path="/"
>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">Beirut &middot; Software Engineer</div>
      <h1>Raphael<br /><em>Fakhri</em></h1>

      <p class="lead">
        I build and own production software end to end&mdash;mobile apps, university web platforms, and backend systems that real users depend on.
      </p>

      <div class="hero-meta">
        <img
          class="avatar"
          src="/raphael.jpg"
          alt="Raphael Fakhri"
          width="48"
          height="48"
          loading="eager"
          decoding="async"
        />
        <div class="actions">
          <a class="btn btn-primary" href="#work">Selected work</a>
          <a class="btn" href="/cv/">CV</a>
          <a class="btn" href="mailto:mail@raphaelfakhri.com">Email</a>
        </div>
      </div>
    </div>

    <div class="hero-stage" data-stage aria-hidden="true">
      <div class="stage-rig">
        <div class="layer-web">
          <div class="chrome">
            <span></span><span></span><span></span>
            <small>aubmed.ac.cy</small>
          </div>
          <img
            src="/work-aubmed.jpg"
            alt=""
            width="1440"
            height="900"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="layer-phone">
          <img
            src="/work-zaky-1.jpg"
            alt=""
            width="560"
            height="1217"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="eyebrow">Selected Work</div>
    <h2>Shipped and owned in production</h2>

    <div class="showcase-list">
      <article class="showcase">
        <a
          class="visual-frame frame-web"
          href="https://aubmed.ac.cy"
          target="_blank"
          rel="noopener noreferrer"
          data-stage
          aria-label="Visit aubmed.ac.cy"
        >
          <div class="frame-rig">
            <div class="browser-shell">
              <div class="chrome">
                <span></span><span></span><span></span>
                <small>aubmed.ac.cy</small>
              </div>
              <img
                src="/work-aubmed.jpg"
                alt="AUB Mediterraneo campus website (aubmed.ac.cy)"
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </a>

        <div class="showcase-copy">
          <span class="meta">01 &middot; American University of Beirut &middot; 2023&ndash;2025</span>
          <h3>AUB Mediterraneo</h3>
          <p>
            Sole developer and designer of the Cyprus campus web platform for two years during my MSc&mdash;50+ responsive pages, in-page PDF viewer, tree navigation, and 200+ staff requests shipped 100% on time.
          </p>
          <div class="facts">
            <span>C# / .NET</span>
            <span>SharePoint</span>
            <span>JavaScript</span>
          </div>
          <a class="visit" href="https://aubmed.ac.cy" target="_blank" rel="noopener noreferrer">
            Visit aubmed.ac.cy &nearr;
          </a>
        </div>
      </article>

      <article class="showcase showcase-reverse">
        <div class="visual-frame frame-phones" data-stage>
          <div class="frame-rig phones-rig">
            <div class="phone phone-back">
              <img
                src="/work-zaky-2.jpg"
                alt="Zaky step-by-step homework solution screen"
                width="560"
                height="1217"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="phone phone-front">
              <img
                src="/work-zaky-1.jpg"
                alt="Zaky mobile tutoring app home screen"
                width="560"
                height="1217"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <div class="showcase-copy">
          <span class="meta">02 &middot; Client Work &middot; Sole Engineer &middot; 2026</span>
          <h3>Zaky</h3>
          <p>
            Architected and shipped a 130+ screen React Native (Expo) tutoring app across iOS, Android, and Web&mdash;serialized MMKV offline sync, native Kotlin Android Credential Manager, LiveKit video classrooms, and a Python/SymPy/Manim homework video pipeline. Live since Oct 2026 (760+ student requests).
          </p>
          <div class="facts">
            <span>React Native / Expo</span>
            <span>Kotlin</span>
            <span>LiveKit</span>
            <span>Python</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="background" class="section">
    <div class="eyebrow">Background</div>
    <h2>Production systems, research &amp; upstream work</h2>

    <div class="ledger">
      <div class="ledger-row">
        <div class="ledger-when">2023</div>
        <div class="ledger-main">
          <h4>Saint Joseph University (USJ)</h4>
          <p>
            Delivered .NET Core &amp; RabbitMQ REST APIs for a Student Information System with vendor CME, migrated production data from MySQL to PostgreSQL, and built a 15+ page Laravel HR module with granular SQL permissions.
          </p>
        </div>
      </div>

      <div class="ledger-row">
        <div class="ledger-when">2025</div>
        <div class="ledger-main">
          <h4>Cardinal Health | WaveMark</h4>
          <p>
            Built an automated Python &amp; DSPy reconciliation agent that detects schema and data drift between staging and production across ClickHouse, Kafka, and Elasticsearch and proposes patches for engineer review.
          </p>
        </div>
      </div>

      <div class="ledger-row">
        <div class="ledger-when">2026</div>
        <div class="ledger-main">
          <h4>24/7 AI Customer Support Platform</h4>
          <p>
            Own a client&rsquo;s end-to-end support agent built on self-hosted Chatwoot and Claude, unifying web chat, Shopify, WhatsApp, email, and mobile routing continuously in production.
          </p>
        </div>
      </div>

      <div class="ledger-row">
        <div class="ledger-when">2023&ndash;2026</div>
        <div class="ledger-main">
          <h4>AUB MSc Thesis &amp; CUDA Systems</h4>
          <p>
            MSc in Computer Science at AUB (GPA 3.81). Thesis: a VS Code extension explaining code in place via eye-tracker gaze, voice, or mouse, evaluated in a controlled user study. Also built <a href="https://github.com/RaphaelFakhri/Generalized_Heaps_Parallel" target="_blank" rel="noopener noreferrer">CUDA parallel heaps</a> cutting 10M+ element sort time by 88%.
          </p>
        </div>
      </div>

      <div class="ledger-row">
        <div class="ledger-when">Open Source</div>
        <div class="ledger-main">
          <h4>Merged Upstream Fixes</h4>
          <p>
            Contributions accepted by maintainers of React Native libraries (Callstack, Software Mansion, RevenueCat), <a href="https://github.com/fluentmigrator/fluentmigrator/pull/2384" target="_blank" rel="noopener noreferrer">FluentMigrator</a>, <a href="https://github.com/domaindrivendev/Swashbuckle.AspNetCore/pull/4128" target="_blank" rel="noopener noreferrer">Swashbuckle</a>, <a href="https://github.com/livekit/livekit/pull/5135" target="_blank" rel="noopener noreferrer">LiveKit</a>, and <a href="https://github.com/versatica/mediasoup/pull/1953" target="_blank" rel="noopener noreferrer">mediasoup</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="eyebrow">Contact</div>
    <h2 class="contact-title">Say hello.</h2>
    <p class="contact-sub">
      Beirut-based. Available for senior mobile and full-stack engineering roles.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="mailto:mail@raphaelfakhri.com">mail@raphaelfakhri.com</a>
      <a class="btn" href="/cv/">Read CV</a>
      <a class="btn" href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>

  <script type="module" src="/spatial3d.js"></script>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      align-items: center;
      gap: 3rem;
      min-height: min(76svh, 640px);
      padding: 1.5rem 0 1rem;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--accent);
    }

    .lead {
      font-size: 1.06rem;
      line-height: 1.68;
      color: var(--text-secondary);
      max-width: 39ch;
      margin: 1.5rem 0 2rem;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border-strong);
      flex-shrink: 0;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.58rem 1.12rem;
      border-radius: 999px;
      border: 1px solid var(--border-strong);
      background: transparent;
      color: var(--text);
      font-size: 0.87rem;
      font-weight: 500;
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
    }

    .btn:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--text);
      text-decoration: none;
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--text);
      border-color: var(--text);
      color: var(--bg);
    }

    .btn-primary:hover {
      background: var(--accent-bright);
      border-color: var(--accent-bright);
      color: var(--bg);
    }

    /* 3D Hero Spatial Stage */
    .hero-stage {
      perspective: 1200px;
      padding: 1.25rem 0.5rem 2.25rem;
    }

    .stage-rig {
      position: relative;
      transform-style: preserve-3d;
      transform: rotateX(calc(5deg + var(--rx, 0deg))) rotateY(calc(-10deg + var(--ry, 0deg)));
      transition: transform 0.08s linear;
    }

    .layer-web {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      box-shadow: 0 32px 70px rgba(0, 0, 0, 0.58);
      transform: translateZ(0px);
    }

    .layer-web img,
    .browser-shell img {
      display: block;
      width: 100%;
      height: auto;
    }

    .chrome {
      display: flex;
      align-items: center;
      gap: 0.36rem;
      padding: 0.55rem 0.8rem;
      background: #171614;
      border-bottom: 1px solid var(--border);
    }

    .chrome span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(242, 239, 233, 0.2);
    }

    .chrome small {
      margin-left: 0.55rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    .layer-phone {
      position: absolute;
      right: -12px;
      bottom: -34px;
      width: 34%;
      border-radius: 22px;
      overflow: hidden;
      border: 3px solid #2b2924;
      background: #090909;
      box-shadow: 0 28px 60px rgba(0, 0, 0, 0.72), 0 0 0 1px rgba(212, 163, 115, 0.25);
      transform: translateZ(56px);
    }

    .layer-phone img {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Featured Showcases */
    .showcase-list {
      display: flex;
      flex-direction: column;
      gap: 5rem;
    }

    .showcase {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3rem;
    }

    .showcase-reverse {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .showcase-reverse .visual-frame {
      order: 2;
    }

    .visual-frame {
      display: block;
      perspective: 1100px;
      padding: 1.8rem;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: radial-gradient(circle at 50% 25%, rgba(212, 163, 115, 0.08), var(--surface) 72%);
      transition: border-color 0.2s ease;
    }

    a.visual-frame:hover {
      border-color: rgba(212, 163, 115, 0.42);
      text-decoration: none;
    }

    .frame-rig {
      transform-style: preserve-3d;
      transform: rotateX(calc(2deg + var(--rx, 0deg))) rotateY(calc(-4deg + var(--ry, 0deg)));
      transition: transform 0.08s linear;
    }

    .browser-shell {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-strong);
      box-shadow: 0 24px 55px rgba(0, 0, 0, 0.55);
    }

    .phones-rig {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      padding: 0.75rem 0;
    }

    .phone {
      width: 44%;
      max-width: 205px;
      border-radius: 24px;
      overflow: hidden;
      border: 3px solid #2b2924;
      background: #0a0a09;
      box-shadow: 0 24px 54px rgba(0, 0, 0, 0.66);
    }

    .phone img {
      display: block;
      width: 100%;
      height: auto;
    }

    .phone-back {
      transform: translateY(14px) translateZ(0px) rotate(-2.5deg);
      opacity: 0.92;
    }

    .phone-front {
      transform: translateY(-10px) translateZ(42px) rotate(1.5deg);
      box-shadow: 0 30px 64px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(212, 163, 115, 0.22);
    }

    .meta {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-bottom: 0.55rem;
    }

    .showcase-copy p {
      font-size: 0.96rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }

    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-bottom: 1.15rem;
    }

    .facts span {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      padding: 0.22rem 0.58rem;
      border-radius: 999px;
      border: 1px solid var(--border);
    }

    .visit {
      display: inline-block;
      font-size: 0.9rem;
      font-weight: 500;
    }

    /* Background ledger */
    .ledger {
      border-top: 1px solid var(--border);
    }

    .ledger-row {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 1.5rem;
      padding: 1.55rem 0;
      border-bottom: 1px solid var(--border);
    }

    .ledger-when {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--text-muted);
      padding-top: 0.2rem;
    }

    .ledger-main h4 {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 600;
      margin: 0 0 0.35rem;
      color: var(--text);
    }

    .ledger-main p {
      font-size: 0.94rem;
      max-width: 62ch;
    }

    /* Contact */
    .contact-title {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      margin-bottom: 0.85rem;
    }

    .contact-sub {
      margin-bottom: 1.75rem;
      font-size: 1rem;
    }

    @media (max-width: 860px) {
      .hero,
      .showcase,
      .showcase-reverse {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .hero {
        min-height: auto;
      }

      .showcase-reverse .visual-frame {
        order: 0;
      }

      .layer-phone {
        right: 6px;
        bottom: -20px;
        width: 32%;
      }

      .ledger-row {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }
    }
  </style>
</Base>
