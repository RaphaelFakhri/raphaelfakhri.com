---
---
<div class="sculpture-wrap" aria-hidden="true">
  <canvas id="rf-sculpture" class="sculpture-canvas"></canvas>
  <div class="sculpture-hint">drag to orbit</div>
</div>

<script>
  const canvas = document.getElementById('rf-sculpture') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (ctx) {
      let width = 0;
      let height = 0;
      let dpr = 1;
      let rafId = 0;
      let visible = true;

      // Build a smooth parametric 3D torus knot (p=2, q=3) tubular mesh
      const U_STEPS = 84;
      const V_STEPS = 14;
      const P = 2;
      const Q = 3;
      const TUBE_R = 0.27;

      type Vec3 = [number, number, number];
      type Quad = { idx: [number, number, number, number]; shade: number };

      function knotPoint(t: number): Vec3 {
        const r = Math.cos(Q * t) + 2.15;
        return [
          r * Math.cos(P * t) * 0.48,
          r * Math.sin(P * t) * 0.48,
          -Math.sin(Q * t) * 0.56,
        ];
      }

      function normalize(v: Vec3): Vec3 {
        const len = Math.hypot(v[0], v[1], v[2]) || 1;
        return [v[0] / len, v[1] / len, v[2] / len];
      }

      function cross(a: Vec3, b: Vec3): Vec3 {
        return [
          a[1] * b[2] - a[2] * b[1],
          a[2] * b[0] - a[0] * b[2],
          a[0] * b[1] - a[1] * b[0],
        ];
      }

      const vertices: Vec3[] = [];
      const quads: Quad[] = [];
      const spine: Vec3[] = [];

      for (let i = 0; i < U_STEPS; i++) {
        const t = (i / U_STEPS) * Math.PI * 2;
        const p0 = knotPoint(t);
        const p1 = knotPoint(t + 0.002);
        spine.push(p0);

        const tangent = normalize([p1[0] - p0[0], p1[1] - p0[1], p1[2] - p0[2]]);
        const up: Vec3 = Math.abs(tangent[1]) < 0.9 ? [0, 1, 0] : [1, 0, 0];
        const normal = normalize(cross(tangent, up));
        const binormal = normalize(cross(tangent, normal));

        for (let j = 0; j < V_STEPS; j++) {
          const phi = (j / V_STEPS) * Math.PI * 2;
          const cp = Math.cos(phi);
          const sp = Math.sin(phi);
          vertices.push([
            p0[0] + TUBE_R * (cp * normal[0] + sp * binormal[0]),
            p0[1] + TUBE_R * (cp * normal[1] + sp * binormal[1]),
            p0[2] + TUBE_R * (cp * normal[2] + sp * binormal[2]),
          ]);
        }
      }

      for (let i = 0; i < U_STEPS; i++) {
        const nextI = (i + 1) % U_STEPS;
        for (let j = 0; j < V_STEPS; j++) {
          const nextJ = (j + 1) % V_STEPS;
          const a = i * V_STEPS + j;
          const b = nextI * V_STEPS + j;
          const c = nextI * V_STEPS + nextJ;
          const d = i * V_STEPS + nextJ;
          quads.push({ idx: [a, b, c, d], shade: 0 });
        }
      }

      // Subtle orbiting architectural nodes
      const particles: Vec3[] = [];
      for (let k = 0; k < 42; k++) {
        const theta = (k / 42) * Math.PI * 2;
        const phi = Math.acos(1 - (2 * (k + 0.5)) / 42);
        const rad = 1.82 + (k % 3) * 0.16;
        particles.push([
          rad * Math.sin(phi) * Math.cos(theta),
          rad * Math.cos(phi),
          rad * Math.sin(phi) * Math.sin(theta),
        ]);
      }

      let rotX = 0.42;
      let rotY = -0.55;
      let targetVelX = 0;
      let targetVelY = 0;
      let pointerX = 0;
      let pointerY = 0;
      let dragging = false;
      let lastX = 0;
      let lastY = 0;

      function resize() {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = Math.max(1, Math.round(width * dpr));
        canvas.height = Math.max(1, Math.round(height * dpr));
      }

      function rotate(v: Vec3, ax: number, ay: number): Vec3 {
        const cy = Math.cos(ay);
        const sy = Math.sin(ay);
        const cx = Math.cos(ax);
        const sx = Math.sin(ax);
        const x1 = v[0] * cy + v[2] * sy;
        const z1 = -v[0] * sy + v[2] * cy;
        const y2 = v[1] * cx - z1 * sx;
        const z2 = v[1] * sx + z1 * cx;
        return [x1, y2, z2];
      }

      const lightDir = normalize([0.55, -0.65, 0.85]);
      const rimDir = normalize([-0.7, 0.45, 0.4]);

      function render(time: number) {
        if (!ctx || width === 0 || height === 0) return;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, width, height);

        const cx = width * 0.5;
        const cy = height * 0.5;
        const scale = Math.min(width, height) * 0.36;
        const fov = 4.6;

        // Soft studio ambient glow behind sculpture
        const glow = ctx.createRadialGradient(cx, cy, scale * 0.1, cx, cy, scale * 1.45);
        glow.addColorStop(0, 'rgba(96, 165, 250, 0.16)');
        glow.addColorStop(0.55, 'rgba(148, 163, 184, 0.05)');
        glow.addColorStop(1, 'rgba(9, 9, 11, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, width, height);

        const ax = rotX + pointerY * 0.25;
        const ay = rotY + pointerX * 0.35;

        // Transform vertices
        const transformed: Vec3[] = new Array(vertices.length);
        const projected: [number, number, number][] = new Array(vertices.length);

        for (let i = 0; i < vertices.length; i++) {
          const tv = rotate(vertices[i], ax, ay);
          transformed[i] = tv;
          const persp = fov / (fov - tv[2]);
          projected[i] = [cx + tv[0] * scale * persp, cy + tv[1] * scale * persp, tv[2]];
        }

        // Subtle orbital ring
        ctx.save();
        ctx.beginPath();
        for (let s = 0; s <= 96; s++) {
          const a = (s / 96) * Math.PI * 2;
          const rv = rotate([Math.cos(a) * 1.88, Math.sin(a) * 0.22, Math.sin(a) * 1.88], ax + 0.35, ay * 0.7);
          const p = fov / (fov - rv[2]);
          const px = cx + rv[0] * scale * p;
          const py = cy + rv[1] * scale * p;
          if (s === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = 'rgba(148, 163, 184, 0.13)';
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.restore();

        // Depth-sort visible faces (back-to-front Painter's algorithm)
        const drawList: { q: Quad; z: number; light: number; rim: number }[] = [];
        for (let i = 0; i < quads.length; i++) {
          const q = quads[i];
          const [i0, i1, i2, i3] = q.idx;
          const v0 = transformed[i0];
          const v1 = transformed[i1];
          const v2 = transformed[i2];
          const v3 = transformed[i3];

          const e1: Vec3 = [v1[0] - v0[0], v1[1] - v0[1], v1[2] - v0[2]];
          const e2: Vec3 = [v3[0] - v0[0], v3[1] - v0[1], v3[2] - v0[2]];
          const n = normalize(cross(e1, e2));

          // Backface cull with slight tolerance for sculptural depth
          if (n[2] < -0.15) continue;

          const z = (v0[2] + v1[2] + v2[2] + v3[2]) * 0.25;
          const diff = Math.max(0, n[0] * lightDir[0] + n[1] * lightDir[1] + n[2] * lightDir[2]);
          const rim = Math.max(0, n[0] * rimDir[0] + n[1] * rimDir[1] + n[2] * rimDir[2]);
          drawList.push({ q, z, light: diff, rim });
        }

        drawList.sort((a, b) => a.z - b.z);

        for (let i = 0; i < drawList.length; i++) {
          const item = drawList[i];
          const [i0, i1, i2, i3] = item.q.idx;
          const p0 = projected[i0];
          const p1 = projected[i1];
          const p2 = projected[i2];
          const p3 = projected[i3];

          const spec = Math.pow(item.light, 4) * 0.55;
          const r = Math.round(24 + item.light * 78 + item.rim * 34 + spec * 130);
          const g = Math.round(30 + item.light * 106 + item.rim * 58 + spec * 145);
          const b = Math.round(44 + item.light * 155 + item.rim * 96 + spec * 155);
          const alpha = 0.72 + item.light * 0.22;

          ctx.beginPath();
          ctx.moveTo(p0[0], p0[1]);
          ctx.lineTo(p1[0], p1[1]);
          ctx.lineTo(p2[0], p2[1]);
          ctx.lineTo(p3[0], p3[1]);
          ctx.closePath();

          ctx.fillStyle = `rgba(${Math.min(255, r)}, ${Math.min(255, g)}, ${Math.min(255, b)}, ${alpha.toFixed(3)})`;
          ctx.fill();

          ctx.strokeStyle = `rgba(191, 219, 254, ${(0.08 + item.light * 0.16).toFixed(3)})`;
          ctx.lineWidth = 0.6;
          ctx.stroke();
        }

        // Orbiting depth-cued nodes
        for (let k = 0; k < particles.length; k++) {
          const pv = rotate(particles[k], ax * 0.8 + time * 0.00012, ay * 0.9 - time * 0.00018);
          const persp = fov / (fov - pv[2]);
          const px = cx + pv[0] * scale * persp;
          const py = cy + pv[1] * scale * persp;
          const depthAlpha = Math.max(0.1, Math.min(0.85, (pv[2] + 2.1) / 3.8));
          const radius = Math.max(0.9, 1.8 * persp);
          ctx.beginPath();
          ctx.arc(px, py, radius, 0, Math.PI * 2);
          ctx.fillStyle = k % 5 === 0
            ? `rgba(147, 197, 253, ${depthAlpha.toFixed(2)})`
            : `rgba(228, 228, 231, ${(depthAlpha * 0.55).toFixed(2)})`;
          ctx.fill();
        }
      }

      function tick(now: number) {
        if (!visible) return;
        if (!dragging) {
          rotY += 0.0042 + targetVelY;
          rotX += 0.0014 + targetVelX;
          targetVelX *= 0.92;
          targetVelY *= 0.92;
        }
        render(now);
        rafId = requestAnimationFrame(tick);
      }

      canvas.addEventListener('pointerdown', (e) => {
        dragging = true;
        lastX = e.clientX;
        lastY = e.clientY;
        canvas.setPointerCapture(e.pointerId);
      });

      canvas.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        pointerX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        pointerY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        lastX = e.clientX;
        lastY = e.clientY;
        rotY += dx * 0.009;
        rotX += dy * 0.009;
        targetVelY = dx * 0.0015;
        targetVelX = dy * 0.0015;
        if (reduced) render(performance.now());
      });

      const endDrag = () => {
        dragging = false;
      };
      canvas.addEventListener('pointerup', endDrag);
      canvas.addEventListener('pointercancel', endDrag);

      const io = new IntersectionObserver(
        (entries) => {
          visible = entries[0]?.isIntersecting ?? true;
          if (visible && !reduced) {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(tick);
          }
        },
        { threshold: 0.05 }
      );
      io.observe(canvas);

      resize();
      window.addEventListener('resize', () => {
        resize();
        if (reduced) render(0);
      });

      if (reduced) {
        render(0);
      } else {
        rafId = requestAnimationFrame(tick);
      }
    }
  }
</script>

<style>
  .sculpture-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin: 0 auto;
    user-select: none;
  }

  .sculpture-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .sculpture-canvas:active {
    cursor: grabbing;
  }

  .sculpture-hint {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.65;
    pointer-events: none;
  }
</style>
