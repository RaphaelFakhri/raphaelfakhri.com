---
interface Props {
  title: string;
  description: string;
  path?: string;
}

const {
  title,
  description,
  path = '/',
} = Astro.props;

const canonical = new URL(path, 'https://raphaelfakhri.com').toString();
const ogImage = 'https://raphaelfakhri.com/og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Raphael Fakhri',
  url: 'https://raphaelfakhri.com',
  image: 'https://raphaelfakhri.com/raphael.jpg',
  jobTitle: 'Software Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Beirut',
    addressCountry: 'LB',
  },
  sameAs: [
    'https://github.com/RaphaelFakhri',
    'https://www.linkedin.com/in/raphaelfakhri',
    'https://x.com/raphaelfakhri2',
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style is:global>
    :root {
      --bg: #0c0c0b;
      --surface: #131311;
      --surface-elevated: #191815;
      --text: #f2efe9;
      --text-secondary: #aba69c;
      --text-muted: #757067;
      --border: rgba(242, 239, 233, 0.09);
      --border-strong: rgba(242, 239, 233, 0.19);
      --accent: #d4a373;
      --accent-bright: #e9c298;
      --accent-soft: rgba(212, 163, 115, 0.11);
      --serif: "Instrument Serif", Georgia, Cambria, "Times New Roman", serif;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --max-w: 1040px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      color-scheme: dark;
    }

    body {
      margin: 0;
      min-height: 100svh;
      background:
        radial-gradient(880px 520px at 82% -6%, rgba(212, 163, 115, 0.09), transparent 68%),
        radial-gradient(640px 480px at 8% 42%, rgba(242, 239, 233, 0.03), transparent 70%),
        var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: clip;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      text-underline-offset: 4px;
    }

    a:hover {
      color: var(--accent-bright);
      text-decoration: underline;
    }

    .container {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(12, 12, 11, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 62px;
    }

    .brand {
      font-family: var(--serif);
      font-size: 1.35rem;
      letter-spacing: -0.01em;
      color: var(--text);
      white-space: nowrap;
    }

    .brand:hover {
      color: var(--accent);
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.65rem;
    }

    .nav-links a {
      font-size: 0.87rem;
      font-weight: 500;
      color: var(--text-secondary);
      transition: color 0.15s ease;
    }

    .nav-links a:hover {
      color: var(--text);
      text-decoration: none;
    }

    main {
      padding: 2.5rem 0 6rem;
    }

    h1 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(3rem, 6.2vw, 4.75rem);
      line-height: 0.98;
      letter-spacing: -0.02em;
      margin: 0;
    }

    h2 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(1.95rem, 3.6vw, 2.7rem);
      line-height: 1.08;
      letter-spacing: -0.015em;
      margin: 0 0 2.5rem;
    }

    h3 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(1.45rem, 2.4vw, 1.85rem);
      line-height: 1.15;
      margin: 0 0 0.65rem;
    }

    p {
      margin: 0;
      color: var(--text-secondary);
    }

    .section {
      margin-top: 6.5rem;
      padding-top: 4.5rem;
      border-top: 1px solid var(--border);
    }

    .eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.8rem;
    }

    .site-footer {
      border-top: 1px solid var(--border);
      padding: 2rem 0 3rem;
      font-size: 0.84rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .footer-links {
      display: flex;
      gap: 1.35rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--text-muted);
    }

    .footer-links a:hover {
      color: var(--text);
      text-decoration: none;
    }

    @media (max-width: 640px) {
      .container {
        padding: 0 1.15rem;
      }

      .nav-inner {
        padding: 0.65rem 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
      }

      .nav-links {
        gap: 1.15rem;
      }

      main {
        padding: 1.75rem 0 4rem;
      }

      .section {
        margin-top: 4.25rem;
        padding-top: 3rem;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav-inner">
      <a class="brand" href="/">Raphael Fakhri</a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#work">Work</a>
        <a href="/#background">Background</a>
        <a href="/cv/">CV</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>&copy; 2026 Raphael Fakhri &middot; Beirut</span>
      <div class="footer-links">
        <a href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/raphaelfakhri2" target="_blank" rel="noopener noreferrer">X</a>
        <a href="/cv/">CV</a>
        <a href="mailto:mail@raphaelfakhri.com">Email</a>
      </div>
    </div>
  </footer>
</body>
</html>
