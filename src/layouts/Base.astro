---
interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  path = '/',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(path, 'https://raphaelfakhri.com').toString();
const ogImage = 'https://raphaelfakhri.com/og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Raphael Fakhri',
  url: 'https://raphaelfakhri.com',
  image: 'https://raphaelfakhri.com/raphael.jpg',
  jobTitle: 'Mobile & Full-Stack Software Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Beirut',
    addressCountry: 'LB',
  },
  sameAs: [
    'https://github.com/RaphaelFakhri',
    'https://www.linkedin.com/in/raphaelfakhri',
    'https://x.com/raphaelfakhri2',
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style is:global>
    :root {
      --bg: #08090c;
      --surface: rgba(255, 255, 255, 0.028);
      --surface-hover: rgba(255, 255, 255, 0.052);
      --text: #f4f4f2;
      --text-secondary: #a1a3ad;
      --text-muted: #6d707c;
      --border: rgba(255, 255, 255, 0.085);
      --border-strong: rgba(255, 255, 255, 0.18);
      --accent: #7db4ff;
      --accent-soft: rgba(96, 165, 250, 0.12);
      --accent-border: rgba(125, 180, 255, 0.3);
      --radius: 18px;
      --max-w: 980px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      color-scheme: dark;
    }

    body {
      margin: 0;
      min-height: 100svh;
      background:
        radial-gradient(900px 520px at 80% -10%, rgba(59, 130, 246, 0.12), transparent 65%),
        radial-gradient(640px 440px at 10% 35%, rgba(148, 163, 184, 0.055), transparent 70%),
        var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 16px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: clip;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      text-underline-offset: 4px;
    }

    a:hover {
      color: #bfdbfe;
      text-decoration: underline;
    }

    .container {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(8, 9, 12, 0.74);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 62px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 650;
      font-size: 0.94rem;
      letter-spacing: -0.015em;
      color: var(--text);
      white-space: nowrap;
    }

    .brand-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px rgba(125, 180, 255, 0.8);
    }

    .brand:hover {
      color: var(--text);
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .nav-links a {
      font-size: 0.87rem;
      font-weight: 500;
      color: var(--text-secondary);
      transition: color 0.15s ease;
    }

    .nav-links a:hover {
      color: var(--text);
      text-decoration: none;
    }

    main {
      padding: 2.5rem 0 5.5rem;
    }

    h1 {
      font-size: clamp(2.35rem, 5.2vw, 3.65rem);
      line-height: 1.06;
      letter-spacing: -0.038em;
      margin: 0;
      font-weight: 700;
    }

    h2 {
      font-size: clamp(1.35rem, 2.4vw, 1.75rem);
      line-height: 1.2;
      letter-spacing: -0.025em;
      margin: 0 0 2rem;
      font-weight: 650;
    }

    h3 {
      font-size: 1.08rem;
      line-height: 1.3;
      letter-spacing: -0.015em;
      margin: 0 0 0.45rem;
      font-weight: 620;
    }

    p {
      margin: 0;
      color: var(--text-secondary);
    }

    .section {
      margin-top: 6rem;
      padding-top: 4rem;
      border-top: 1px solid var(--border);
    }

    .eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent);
      margin-bottom: 0.65rem;
    }

    .site-footer {
      border-top: 1px solid var(--border);
      padding: 2rem 0 3rem;
      font-size: 0.84rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .footer-links {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--text-muted);
    }

    .footer-links a:hover {
      color: var(--text);
      text-decoration: none;
    }

    @media (max-width: 640px) {
      .container {
        padding: 0 1.15rem;
      }

      .nav-inner {
        padding: 0.65rem 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.4rem;
      }

      .nav-links {
        gap: 1.1rem;
      }

      main {
        padding: 1.5rem 0 4rem;
      }

      .section {
        margin-top: 4rem;
        padding-top: 2.75rem;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav-inner">
      <a class="brand" href="/">
        <span class="brand-dot" aria-hidden="true"></span>
        <span>Raphael Fakhri</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#story">Story</a>
        <a href="/#work">Work</a>
        <a href="/#writing">Writing</a>
        <a href="/cv/">CV</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>&copy; 2026 Raphael Fakhri &middot; Beirut</span>
      <div class="footer-links">
        <a href="https://github.com/RaphaelFakhri" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/raphaelfakhri" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/raphaelfakhri2" target="_blank" rel="noopener noreferrer">X</a>
        <a href="/cv/">CV</a>
        <a href="mailto:mail@raphaelfakhri.com">Email</a>
      </div>
    </div>
  </footer>
</body>
</html>
