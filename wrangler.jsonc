{
  // Worker for raphaelfakhri.com. GitHub is the single source of truth:
  // Astro builds static pages to ./dist and the Worker serves ./dist with
  // caching, security headers, and legacy URL redirects.
  "name": "raphaelfakhri",
  "compatibility_date": "2026-07-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SITE_DO", "class_name": "Site" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Site"] }
  ]
}
